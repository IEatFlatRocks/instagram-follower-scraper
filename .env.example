# Sometimes updating the .env file requires a restart of the terminal or IDE.

# Instagram credentials
INSTAGRAM_USERNAME=your_username
INSTAGRAM_PASSWORD=your_password

# Target settings
TARGET_USERNAME=target_username
HASHTAG=your_hashtag
NICHE=your_niche

# Scraping limits
MAX_USERS=100
MAX_FOLLOWERS=100000
MIN_FOLLOWERS=200

# Output settings
CSV_FILENAME=influencers.csv

# API keys
GROQ_API_KEY=your_api_key